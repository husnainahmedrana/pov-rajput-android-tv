// pov.rajput.cc: the POV Rajput website, static files served by Cloudflare (free plan).
// Deploy: npx wrangler deploy   (short links like /tv and /phone are in public/_redirects)
{
  "name": "pov-site",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page" },
  "workers_dev": false,
  "routes": [{ "pattern": "pov.rajput.cc", "custom_domain": true }]
}
